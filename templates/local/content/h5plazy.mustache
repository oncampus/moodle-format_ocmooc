{{!
    @template format_ocmooc/local/content/h5plazy

    Placeholder for an embedded H5P iframe in the editing view.

    The embedded iframe is deferred (its src has been moved to data-src by the
    PHP helper) and only loaded when the editor clicks the button. The click is
    handled by the format_ocmooc/h5plazy AMD module.

    Context variables required for this template:
    * notice - Notice text shown next to the button.
    * button - Label of the "load preview" button.
    * iframe - The deferred iframe markup (raw HTML, already sanitised upstream).

    Example context (json):
    {
        "notice": "Interaktiver H5P-Inhalt (im Bearbeitungsmodus nicht geladen)",
        "button": "H5P-Vorschau laden",
        "iframe": "<iframe class=\"h5p-lazy-frame\" hidden data-src=\"...\"></iframe>"
    }
}}
<div class="h5p-lazy" data-region="h5p-lazy">
    <div class="h5p-lazy-prompt">
        <span class="h5p-lazy-label">
            <i class="icon fa fa-cube fa-fw" aria-hidden="true"></i>
            {{notice}}
        </span>
        <button type="button" class="btn btn-sm btn-primary ms-2" data-action="h5plazy-load">
            {{button}}
        </button>
    </div>
    {{{iframe}}}
</div>
