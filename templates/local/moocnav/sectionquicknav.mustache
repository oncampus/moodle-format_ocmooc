{{#quicknav}}
    <hr>
    <div id="" class="oc-div-footerlinks-outer card-text content">
        <div id="" class="oc-div-footerlinks ">
            <div class="d-flex justify-content-center">
                
                <div
                        {{^firstsection}}id="oc-div-prevlection"{{/firstsection}}
                    {{#firstsection}} id="oc-div-prevlection-inactive"{{/firstsection}}>
                    <a class=" btn-secondary p-2 user-select-none"
                        {{^firstsection}} href="{{prevsection}} "{{/firstsection}}>
                        &#60;
                        {{#str}} footernav:prev, format_ocmooc {{/str}}
                    </a>
                </div>
                
                <div id="oc-div-up" class="mx-2">
                    <a class="btn-primary p-2 user-select-none" href="#moocnav">
                        {{#str}} footernav:top, format_ocmooc {{/str}}
                    </a>
                </div>

                <div
                        {{^lastsection}}id="oc-div-nextlextion"{{/lastsection}}
                    {{#lastsection}} id="oc-div-nextlextion-inactive"{{/lastsection}}>
                    <a class="btn-secondary p-2 user-select-none"{{^lastsection}} href="{{nextsection}}" disabled="" {{/lastsection}}>
                        {{#str}} footernav:next, format_ocmooc {{/str}}
                        &#62;
                    </a>
                </div>
            </div>
        </div>
    </div>
{{/quicknav}}