<div id="oc-chapters-navigation" class="wrap">
    <button class="chapters-control-prev chapters-nav-btn btn" onclick="slideRight()">
        <i class="icon fa fa-chevron-left fa-fw text-dark" title="Zurück" aria-hidden="true"></i>
        <span class="sr-only">Previous</span>
    </button>
    <button class="chapters-control-next chapters-nav-btn btn" onclick="slideLeft()">
        <i class="icon fa fa-chevron-right fa-fw text-dark" title="Vor" aria-hidden="true"></i>
        <span class="sr-only">Next</span>
    </button>
    <div class="oc-chapter-mask">
        <div id="oc-chapters-nav-inner" class="frame w-100 mx-auto" style="overflow: hidden; padding-top:20px;">
            <ul id="oc-chapters-slider" class="clearfix" style="width: {{chaptersstartwidth}}px; transform: translateX({{chapterstarttransform}}px);">
                {{#chapters}}
                    <li class="oc-chapter-item {{#selected}}active{{/selected}}">
                        {{#imgurl}}
                            <a class="chapter-card d-block h-100 w-100" href="{{url}}">
                                <img src="{{imgurl}}" alt="{{imgalt}}" class="chapter-img {{#selected}}active{{/selected}}">
                            </a>
                            <i class="icon activicon fa fa-map-marker fa-fw text-dark" title="Zurück" aria-hidden="true"></i>
                        {{/imgurl}}
                        {{^imgurl}}
                            <a class="chapter-card d-block bg-light border border-grey border-1 w-100 h-100" href="{{url}}">
                                <i class="icon noimage fa fa-file-o fa-fw text-dark" title="Nothing" aria-hidden="true"></i>
                            </a>
                            <i class="icon activicon fa fa-map-marker fa-fw text-dark" title="Zurück" aria-hidden="true"></i>
                        {{/imgurl}}
                    </li>
                {{/chapters}}
            </ul>
        </div>
    </div>
</div>
