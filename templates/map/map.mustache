<link rel="stylesheet" href="/course/format/ocmooc/leaflet/leaflet.css" />
<script src="/course/format/ocmooc/leaflet/leaflet.js"></script>

<h2 class="pt-3">{{#str}}worldmap, format_ocmooc{{/str}}</h2>
<div id="map" class="mt-3" style="width: 100%; height: 500px;"></div>

<script>
    // Initialize the Leaflet map with a starting view centered on Germany (latitude 51.1657, longitude 10.4515)
    let map = L.map('map').setView([51.1657, 10.4515], 5);

    // Add OpenStreetMap tiles as the map layer with attribution
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Declare variables outside the loop to avoid re-declaration errors
    let participantString;
    let popupContent;

        {{#markers}}
        // Assign the participant string based on the participant count
        participantString = parseInt('{{participant_count}}') === 1
                ? '{{#str}}participant, format_ocmooc{{/str}}' // Singular (e.g., "1 participant")
                : '{{#str}}participants, core{{/str}}';       // Plural (e.g., "2 participants")

        // Generate the popup content for the marker
        popupContent = '<b>{{location_name}}</b><br>' + '{{participant_count}}' + ' ' + participantString;

        // Add a marker to the map at the specified latitude and longitude
        // The marker includes an alt attribute for accessibility
        L.marker([parseFloat('{{latitude}}'), parseFloat('{{longitude}}')], {
            alt: '{{location_name}}: ' + '{{participant_count}}' + ' ' + participantString // Screen reader-friendly description
        }).addTo(map)
                .bindPopup(popupContent); // Bind the popup content to the marker
        {{/markers}}
</script>